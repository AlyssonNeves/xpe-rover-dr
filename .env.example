# Rover-DR security configuration example.
# Never commit real credentials. Copy the names to the EV3 environment and
# generate two independent cryptographically random values.

ROVER_SHUTDOWN_TOKEN=<generated-shutdown-token>
ROVER_HARDWARE_API_TOKEN=<generated-hardware-token>

# Remote shutdown/restart requires an explicit {"confirm": true} by default.
ROVER_SHUTDOWN_CONFIRMATION_REQUIRED=true
