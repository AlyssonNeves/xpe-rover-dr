# Optional explicit configuration file. When set, the file must exist.
# ROVER_CONFIG_FILE=/home/robot/rover-config/rover_config.json

# Enables all physical EV3 integrations: motors, sensors, display, buttons,
# LEDs, and sound. Set to false for simulation-only development.
ROVER_HARDWARE_ENABLED=true

# Optional REST binding overrides for deployment/network differences.
# ROVER_REST_HOST=0.0.0.0
# ROVER_REST_PORT=8080

# Use two different cryptographically random values. Never commit real tokens.
ROVER_SHUTDOWN_TOKEN=<generated-shutdown-token>
ROVER_HARDWARE_API_TOKEN=<generated-hardware-token>
