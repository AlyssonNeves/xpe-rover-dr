# Rover-DR deployment configuration example.
# Never commit real credentials.

# Global switch for physical EV3 integrations. Set false for development
# without motors, sensors, display, buttons, LEDs or sound.
ROVER_HARDWARE_ENABLED=true

# Shutdown/restart is always protected.
ROVER_SHUTDOWN_TOKEN=<generated-shutdown-token>

# Required only when ROVER_HARDWARE_ENABLED=true.
ROVER_HARDWARE_API_TOKEN=<generated-hardware-token>

# Remote shutdown/restart requires explicit {"confirm": true} by default.
ROVER_SHUTDOWN_CONFIRMATION_REQUIRED=true

# Optional deployment override.
ROVER_APPLICATION_VERSION=0.1.0
