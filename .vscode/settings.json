{
    // ============================================================
    // EV3DEV BROWSER
    // ============================================================

    // Always downloads the current VS Code project to:
    // /home/robot/XPE-Rover-DR
    "ev3devBrowser.download.directory": "XPE-Rover-DR",

    // Excludes files and directories that are not required for
    // deployment and execution of the Rover-DR on the EV3:
    // - Development and test files: .github, scripts, tests, .venv,
    //   requirements files, setup.cfg, and pytest.ini
    // - Generated and coverage files: .pytest_cache, __pycache__,
    //   *.pyc, htmlcov, coverage.xml, and .coveragerc
    // - Documentation: *.md, *.pdf, and LICENSE
    // - Source images: assets/images, docs/assets, and *.svg
    // - Hidden files and directories
    "ev3devBrowser.download.exclude": "{.github/**,scripts/**,tests/**,.venv/**,requirements-dev.txt,requirements.txt,setup.cfg,pytest.ini,.pytest_cache/**,**/__pycache__/**,**/*.pyc,htmlcov/**,coverage.xml,.coveragerc,**/*.md,**/*.MD,**/*.pdf,**/*.PDF,LICENSE,assets/images/**,docs/assets/**,**/*.svg,**/*.SVG,**/.*}",

    // ============================================================
    // FILES
    // ============================================================

    "files.eol": "\n",
    "files.insertFinalNewline": true,

    // ============================================================
    // TERMINAL
    // ============================================================

    "terminal.integrated.defaultProfile.windows": "Command Prompt",

    // ============================================================
    // PYTHON
    // ============================================================

    "python.analysis.typeCheckingMode": "basic",

    // ============================================================
    // FOLDER COMPARISON
    // ============================================================

    "compareFolders.excludeFilter": [
        "**/.git/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "**/.coverage",
        "**/coverage.xml",
        "**/htmlcov/**",
        "/.venv"
    ]
}
