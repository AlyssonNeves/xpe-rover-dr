{
  "info": {
    "name": "Rover-DR REST API - Validation and Hardening",
    "description": "Read-only Rover-DR API with command validation, standardized errors and method protection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Rover State",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rover/state"
      }
    },
    {
      "name": "Sensors",
      "item": [
        {
          "name": "List sensors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "Read all sensors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/all"
          }
        },
        {
          "name": "Read sensor TMP",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/TMP"
          }
        }
      ]
    },
    {
      "name": "Motors",
      "item": [
        {
          "name": "List motors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors"
          }
        },
        {
          "name": "Read all motors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/all"
          }
        },
        {
          "name": "Read motor LLM",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/LLM"
          }
        }
      ]
    },
    {
      "name": "Controller",
      "item": [
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/status"
          }
        },
        {
          "name": "Network",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/network"
          }
        },
        {
          "name": "Battery",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/battery"
          }
        },
        {
          "name": "System",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/system"
          }
        }
      ]
    },
    {
      "name": "Validation and Errors",
      "item": [
        {
          "name": "Unknown sensor - 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/XYZ"
          }
        },
        {
          "name": "Invalid sensor code - 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/%21invalid"
          }
        },
        {
          "name": "Unknown motor - 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/XYZ"
          }
        },
        {
          "name": "Unknown endpoint - 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/not-found"
          }
        },
        {
          "name": "POST not allowed - 405",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "CORS preflight - 204",
          "request": {
            "method": "OPTIONS",
            "url": "{{baseUrl}}/api/sensors"
          }
        }
      ]
    }
  ]
}
