{
  "info": {
    "name": "Rover-DR REST API - Differential Drive",
    "description": "Validated Rover-DR API with motor safety, asynchronous command orchestration and initial differential-drive control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Rover State",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rover/state"
      }
    },
    {
      "name": "Sensors",
      "item": [
        {
          "name": "List sensors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "Read all sensors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/all"
          }
        },
        {
          "name": "Read sensor TMP",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/TMP"
          }
        }
      ]
    },
    {
      "name": "Motors",
      "item": [
        {
          "name": "List motors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors"
          }
        },
        {
          "name": "Read all motors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/all"
          }
        },
        {
          "name": "Read motor LLM",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/LLM"
          }
        },
        {
          "name": "Run timed LLM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speed_sp\": 200,\n  \"time_sp\": 500,\n  \"timeout_ms\": 3000,\n  \"stop_action\": \"brake\",\n  \"priority\": 50\n}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/run-timed"
          }
        },
        {
          "name": "Run forever LLM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speed_sp\": 150,\n  \"watchdog_ms\": 2000,\n  \"timeout_ms\": 10000,\n  \"stop_action\": \"brake\",\n  \"priority\": 50\n}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/run-forever"
          }
        },
        {
          "name": "Stop LLM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stop_action\": \"brake\"\n}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/stop"
          }
        },
        {
          "name": "Move LLM relative position",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speed_sp\": 200,\n  \"position_sp\": 180,\n  \"stop_action\": \"hold\",\n  \"priority\": 50\n}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/run-to-rel-pos"
          }
        },
        {
          "name": "Reset LLM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/reset"
          }
        },
        {
          "name": "Cancel LLM commands",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/cancel"
          }
        },
        {
          "name": "List motor commands",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motor-commands"
          }
        },
        {
          "name": "Read motor command 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motor-commands/1"
          }
        },
        {
          "name": "List LLM commands",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/LLM/commands"
          }
        },
        {
          "name": "Synchronized LLM and RLM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": 80,\n  \"commands\": [\n    {\n      \"code\": \"LLM\",\n      \"action\": \"run-timed\",\n      \"speed_sp\": 200,\n      \"time_sp\": 500,\n      \"stop_action\": \"brake\"\n    },\n    {\n      \"code\": \"RLM\",\n      \"action\": \"run-timed\",\n      \"speed_sp\": 200,\n      \"time_sp\": 500,\n      \"stop_action\": \"brake\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/motors/synchronized"
          }
        }
      ]
    },
    {
      "name": "Controller",
      "item": [
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/status"
          }
        },
        {
          "name": "Network",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/network"
          }
        },
        {
          "name": "Battery",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/battery"
          }
        },
        {
          "name": "System",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/controller/system"
          }
        }
      ]
    },
    {
      "name": "Drive",
      "item": [
        {
          "name": "Drive Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/drive/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "drive",
                "status"
              ]
            }
          }
        },
        {
          "name": "Drive Tank",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"left_speed_sp\": 300,\n  \"right_speed_sp\": 250,\n  \"priority\": 60,\n  \"watchdog_ms\": 2000,\n  \"stop_action\": \"brake\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/drive/tank",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "drive",
                "tank"
              ]
            }
          }
        },
        {
          "name": "Drive Stop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stop_action\": \"brake\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/drive/stop",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "drive",
                "stop"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Validation and Errors",
      "item": [
        {
          "name": "Unknown sensor - 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/XYZ"
          }
        },
        {
          "name": "Invalid sensor code - 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sensors/%21invalid"
          }
        },
        {
          "name": "Unknown motor - 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/motors/XYZ"
          }
        },
        {
          "name": "Unknown endpoint - 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/not-found"
          }
        },
        {
          "name": "PUT not allowed - 405",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "CORS preflight - 204",
          "request": {
            "method": "OPTIONS",
            "url": "{{baseUrl}}/api/sensors"
          }
        },
        {
          "name": "Invalid motor speed - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speed_sp\": \"fast\",\n  \"time_sp\": 500\n}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/run-timed"
          }
        },
        {
          "name": "Invalid motor watchdog - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speed_sp\": 150,\n  \"watchdog_ms\": 50\n}"
            },
            "url": "{{baseUrl}}/api/motors/LLM/run-forever"
          }
        }
      ]
    }
  ]
}
